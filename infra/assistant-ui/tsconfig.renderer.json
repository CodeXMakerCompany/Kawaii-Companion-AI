{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "outDir": "public",
    "rootDir": "src",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/domain/**/*",
    "src/application/**/*",
    "src/infrastructure/**/*"
  ]
}
