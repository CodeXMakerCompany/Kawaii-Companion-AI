{
  "name": "electron-live2d-poc",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --host=localhost --port=12393",
    "backend": "node out/backend/server.js",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:all": "npm run build && npm run build:backend"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.0",
    "electron": "^28.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.14.0"
  }
}
